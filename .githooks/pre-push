#!/usr/bin/env bash
set -euo pipefail

hooks_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! "$hooks_directory/publish-soft-skills.sh" --push </dev/null; then
  printf 'Publication pending, so the push stopped. Retry with %s/publish-soft-skills.sh --retry, then push again.\n' "$hooks_directory" >&2
  exit 1
fi
